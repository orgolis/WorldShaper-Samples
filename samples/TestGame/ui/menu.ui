# The title screen, shown when the game starts.
ui modal pause layer=20
panel  id=bg       anchor=fill color=0.02,0.03,0.05,0.85
panel  id=band     anchor=center x=0 y=-210 w=1920 h=300 color=0,0,0,0.35 radius=0 border=0,0,0,0 border_width=1.5 shadow=1
label  id=title    anchor=center x=0 y=-280 w=1400 h=130 text="THE BEACON" size=112 align=center color=1,0.84,0.32,1 bold=1 shadow=1
label  id=tagline  anchor=center x=0 y=-212 w=1400 h=36 text="a GameWorldshaper test game" size=24 align=center color=1,0.9,0.7,0.55
label  id=intro    anchor=center x=0 y=-170 w=1500 h=50 text="Clear the creature camps in the hills, then reach the beacon on the far side." size=28 align=center color=0.9,0.92,1,0.9
button id=start    anchor=center x=0 y=-50 w=440 h=76 text="Start" size=34 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
button id=settings anchor=center x=0 y=50 w=440 h=76 text="Settings" size=34 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
button id=quit     anchor=center x=0 y=150 w=440 h=76 text="Quit" size=34 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
