# The skill tree: spend skill points (one a level). It grows from Awakening at the
# bottom; a skill needs the ones under it (a line to each). Click a skill to learn it.
ui modal pause layer=45
panel  id=dim      anchor=fill color=0,0,0,0.55
panel  id=card     anchor=center x=0 y=0 w=1860 h=1040 color=0.06,0.08,0.12,0.95 radius=12 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=title    anchor=center x=0 y=-478 w=800 h=64 text="Skill Tree" size=48 align=center bold=1 shadow=1
label  id=level    anchor=center x=-660 y=-486 w=400 h=40 text="Level {player.level}" size=28 align=center color=1,0.92,0.7,1 bold=1
bar    id=xp       anchor=center x=-660 y=-456 w=320 h=12 color=0.95,0.75,0.25,1 bind=player.xp radius=6 bg=0.02,0.03,0.05,0.75 border=0,0,0,0.6 border_width=1.5
label  id=points   anchor=center x=660 y=-470 w=500 h=44 text="Skill points: {player.skill_points}" size=30 align=center color=0.6,0.9,1,1 bold=1
label  id=h_sorcery   anchor=center x=-574 y=-414 w=400 h=34 text="Sorcery" size=26 align=center color=1,0.86,0.5,1 bold=1
label  id=h_survival  anchor=center x=0 y=-414 w=400 h=34 text="Survival" size=26 align=center color=1,0.86,0.5,1 bold=1
label  id=h_agility   anchor=center x=574 y=-414 w=400 h=34 text="Agility" size=26 align=center color=1,0.86,0.5,1 bold=1
skilltree id=tree   anchor=center x=0 y=-38 w=1780 h=700 bind=hero node_w=140 node_h=60 size=16
label  id=picked   anchor=center x=0 y=348 w=1600 h=40 text="{tree.name}" size=30 align=center color=1,0.86,0.5,1 bold=1
label  id=about    anchor=center x=0 y=386 w=1760 h=30 text="{tree.info}" size=21 align=center color=0.85,0.9,1,0.9
label  id=stats    anchor=center x=0 y=424 w=1760 h=28 text="Health {player.Health}     Speed +{player.MoveSpeed}%     Damage +{player.Damage}%     Cooldowns -{player.CooldownReduction}%     Reload +{player.ReloadSpeed}%     Regen {player.HealthRegen}/s     Air jumps {player.ExtraJumps}" size=19 align=center color=1,1,1,0.7
button id=open_abilities anchor=center x=-170 y=476 w=300 h=50 text="Abilities ({key.abilities})" size=24 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
button id=skills_close   anchor=center x=170 y=476 w=300 h=50 text="Close" size=24 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
