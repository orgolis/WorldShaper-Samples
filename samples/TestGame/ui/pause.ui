button id=settings anchor=center x=0 y=100 w=400 h=66 text="Settings" size=28 color=0.11,0.14,0.2,0.96 hover=0.2,0.26,0.36,1 radius=8 border=1,0.85,0.55,0.32 border_hover=1,0.85,0.55,0.95 bold=1
