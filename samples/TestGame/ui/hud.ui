# The HUD: health, the objective, level and skill points; in the lower left corner
# the ability slots (each its key, its cooldown over it) and the gun: its name, the
# rounds, the reload, the weapon slots, the grenades.
ui layer=0
panel  id=box       anchor=top_left x=20 y=20 w=470 h=68 color=0.04,0.06,0.09,0.6 radius=8 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=hp_label  anchor=top_left x=36 y=37 w=60 h=34 text="HP" size=30 color=1,0.82,0.8,1 shadow=1
bar    id=hp        anchor=top_left x=100 y=38 w=370 h=32 color=0.85,0.22,0.2,1 bind=player.Health radius=6 bg=0.02,0.03,0.05,0.75 border=0,0,0,0.6 border_width=1.5
label  id=hp_value  anchor=top_left x=100 y=38 w=370 h=32 text="{player.Health}" size=26 align=center shadow=1
panel  id=obj_box   anchor=top x=0 y=20 w=720 h=62 color=0.04,0.06,0.09,0.6 radius=8 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=objective anchor=top x=0 y=20 w=720 h=62 text="Clear the creature camps" size=34 align=center color=1,0.92,0.7,1 bold=1 shadow=1
panel  id=lv_box    anchor=top_right x=-20 y=20 w=380 h=120 color=0.04,0.06,0.09,0.6 radius=8 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=level     anchor=top_right x=-36 y=30 w=348 h=36 text="Level {player.level}" size=30 color=1,0.92,0.7,1 bold=1 shadow=1
bar    id=xp        anchor=top_right x=-36 y=72 w=348 h=16 color=0.95,0.75,0.25,1 bind=player.xp radius=6 bg=0.02,0.03,0.05,0.75 border=0,0,0,0.6 border_width=1.5
label  id=points    anchor=top_right x=-36 y=96 w=348 h=34 text="Skill points: {player.skill_points}   ({key.skills})" size=22 color=1,1,1,0.8 bold=1 shadow=1
label  id=keys      anchor=bottom_left x=20 y=-14 w=1880 h=34 text="{key.fire} fire   {key.aim} aim   {key.reload} reload   {key.next_weapon} next gun   {key.grenade} grenade   {key.dash} dash   {key.interact} use   {key.inventory} inventory   {key.skills} skills   {key.abilities} abilities   Esc menu" size=19 color=1,1,1,0.6 shadow=1
panel  id=ab_box    anchor=bottom_left x=20 y=-56 w=372 h=150 color=0.04,0.06,0.09,0.6 radius=8 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=ab_title  anchor=bottom_left x=36 y=-170 w=340 h=26 text="Abilities" size=19 color=1,0.86,0.5,0.9 shadow=1
slots  id=hud_abil  anchor=bottom_left x=32 y=-64 w=348 h=104 cols=3 rows=1 size=16 bind=player.abilities frame=0.55,0.85,1,0.95 radius=6 border=1,1,1,0.1 border_width=1
panel  id=gun_box   anchor=bottom_left x=404 y=-56 w=600 h=150 color=0.04,0.06,0.09,0.6 radius=8 border=1,0.85,0.55,0.28 border_width=1.5 shadow=1
label  id=gun_name  anchor=bottom_left x=420 y=-166 w=290 h=30 text="{player.weapon}" size=24 color=1,0.86,0.5,1 bold=1 shadow=1
label  id=ammo      anchor=bottom_left x=420 y=-100 w=130 h=60 text="{player.ammo}" size=54 align=right bold=1 shadow=1
label  id=reserve   anchor=bottom_left x=558 y=-108 w=150 h=40 text="/ {player.reserve}" size=28 color=1,1,1,0.75 shadow=1
bar    id=reload    anchor=bottom_left x=420 y=-86 w=280 h=8 color=1,0.86,0.5,1 bind=player.reload radius=6 bg=0.02,0.03,0.05,0.75 border=0,0,0,0.6 border_width=1.5
label  id=grenades  anchor=bottom_left x=420 y=-60 w=290 h=24 text="Grenades {player.item.frag_grenade}   [{key.grenade}]" size=18 color=1,1,1,0.85 shadow=1
label  id=gun_title anchor=bottom_left x=716 y=-170 w=278 h=26 text="Weapons" size=19 color=1,0.86,0.5,0.9 shadow=1
slots  id=hud_guns  anchor=bottom_left x=716 y=-64 w=278 h=104 cols=3 rows=1 size=13 bind=player.weapons radius=6 border=1,1,1,0.1 border_width=1
