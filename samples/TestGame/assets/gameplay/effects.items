# How things look in this game: effect blocks (the format is in the engine's
# vfx/effects.h). Anything not named here uses the engine's built-in effect:
# guns <gun>_muzzle / _tracer / _impact / _hit, abilities <vfx>_windup / _cast /
# _trail / _beam / _hit / _area / _self (else by damage type: fire, cold, shock...).

# The creatures' claws: a red glow as they rear up, then the swipe.
effect claw_windup
  layer glow   rate 50 life 0.12 0.2 size 0.35 0.1 color 2.5 0.5 0.3 1 to 1 0.1 0.05 0 jitter 0.25
  layer sparks rate 30 life 0.15 0.3 speed 0.5 1.5 dir up spread 50 size 0.06 0.02 color 3 0.8 0.4 1 to 1 0.2 0.1 0 jitter 0.3
end
effect claw_cast
  layer swipe  count 14 life 0.08 0.16 speed 9 16 spread 22 size 0.07 0.03 color 3 1.2 0.8 1 to 1.5 0.3 0.2 0 streak 0.05
end
effect claw_hit
  layer blood  count 10 life 0.25 0.5 speed 1.5 4 dir normal spread 60 size 0.06 0.03 color 0.5 0.05 0.04 0.95 to 0.3 0.02 0.02 0.5 blend gravity 9.8
end

# The spitters: green bubbling, a glob that arcs, a splash.
effect spit_windup
  layer bubbles rate 60 life 0.25 0.5 speed 0.3 1 dir up spread 50 size 0.12 0.04 color 0.8 2.6 0.4 1 to 0.3 1 0.2 0 jitter 0.3
end
effect spit_trail
  light 0.4 1 0.3 5 4 0.05
  layer glob   rate 140 life 0.08 0.14 size 0.42 0.18 color 1 3 0.5 1 to 0.4 1.2 0.2 0
  layer drips  rate 50 life 0.4 0.7 speed 0.2 1 dir any size 0.08 0.03 color 0.25 0.6 0.1 0.9 to 0.2 0.5 0.08 0 blend gravity 7
  layer fume   rate 20 life 0.5 1 speed 0.1 0.4 dir any size 0.25 0.7 color 0.35 0.6 0.2 0.35 to 0.4 0.6 0.25 0 blend gravity -0.4
end
effect spit_hit
  layer splash count 28 life 0.3 0.7 speed 2 6 dir normal spread 70 size 0.13 0.05 color 0.3 0.7 0.12 0.95 to 0.2 0.5 0.1 0.4 blend gravity 9.8
  layer glow   count 2 life 0.08 0.14 size 1 0.3 color 1.2 3 0.6 1 to 0.4 1 0.2 0
  layer fume   count 10 life 0.9 1.6 speed 0.3 1 dir any size 0.4 1.3 color 0.35 0.6 0.2 0.4 to 0.4 0.6 0.25 0 blend gravity -0.4 drag 2
end

# The shotgun's muzzle: wider and heavier than the built-in one, lighting more round it.
effect shotgun_muzzle
  light 1 0.6 0.25 24 9 0.08
  layer core   count 3 life 0.04 0.06 size 0.4 0.18 color 9 5.5 2.2 1 to 4 1.6 0.4 0 jitter 0.02
  layer cone   count 12 life 0.04 0.07 speed 2 6 spread 12 size 0.2 0.05 color 7 3.6 1.1 1 to 3 1 0.2 0 streak 0.06
  layer sparks count 10 life 0.08 0.2 speed 8 20 spread 16 size 0.025 0.008 color 5 3 1.2 1 to 2 0.6 0.1 0 streak 0.03 gravity 4 drag 2
  layer smoke  count 12 life 0.8 1.5 speed 0.4 1.6 spread 22 size 0.08 0.6 color 0.6 0.58 0.55 0.25 to 0.62 0.62 0.62 0 blend drag 3.5 gravity -0.5 jitter 0.05
end
