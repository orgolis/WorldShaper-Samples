# TestGame combat builds: percentage bonuses add within each damage family.
# Three equipped abilities. Abilities use cooldowns and cast rules, with no resource costs.
ability lightning
  name Lightning
  cooldown 4
  cast 0.05
  target aimed
  range 100
  damage 100 shock
  vfx lightning
  about Instant long-range strike for 100 shock damage.
end

ability ice_lance
  name Ice Lance
  cooldown 3
  cast 0.15
  target aimed
  range 90
  damage 80 cold
  speed 80
  effect MoveSpeed -35 3
  about 80 cold damage and 35% slow for 3 seconds.
end

ability shock_wave
  name Shock Wave
  cooldown 8
  target area
  radius 10
  damage 65 shock
  effect MoveSpeed -40 2
  about 65 shock damage in a 10m ring; slows by 40% for 2 seconds.
end

ability meteor
  name Meteor
  cooldown 12
  cast 0.65
  still
  target area_at_aim
  range 120
  radius 7
  damage 180 fire
  speed 55
  arc 9.8
  about Hold still to launch an arcing 180-damage meteor; 7m blast.
end

ability venom_rain
  name Venom Rain
  cooldown 12
  channel 3 0.5
  target area_at_aim
  range 110
  radius 6
  damage 32 poison
  about Hold to channel 32 poison damage per pulse, every 0.5s for 3s.
end

ability battle_cry
  name Battle Cry
  cooldown 20
  target self
  self Damage 30 8
  about All shots and spells deal 30% more damage for 8 seconds.
end

ability second_wind
  name Second Wind
  cooldown 25
  target self
  self Health 35
  self HealthRegen 8 5

  about Heal 35 now, then regenerate 8 health/s for 5 seconds.
end

ability surge
  name Surge
  cooldown 4
  target self
  move dash 13
  about Dash 13m along your view; free emergency movement.
end

ability leap
  name Leap
  cooldown 7
