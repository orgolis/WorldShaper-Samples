# The hero's abilities and skill tree. Skills cost the points the player earns by
# levelling up. K opens the tree: it grows from Awakening at the bottom, a skill
# needing the ones under it. Abilities have no cost but their cooldown; the player
# has 3 ability slots (P: Abilities puts known ones in them). Passives ("grant")
# raise bonus stats: MoveSpeed, Damage, CooldownReduction, ReloadSpeed (all %),
# HealthRegen (a second), ExtraJumps -- and Health.

ability lightning
  name Lightning
  cooldown 4
  cast 0.2
  target aimed
  range 60
  damage 55 shock
  vfx lightning
  about A bolt of lightning at what you aim at, far away.
end

ability ice_lance
  name Ice Lance
  cooldown 3
  cast 0.25
  target aimed
  range 45
  damage 40 cold
  speed 60
  effect Speed -3 3
  about A shard of ice that flies straight and slows what it hits.
end

ability shock_wave
  name Shock Wave
  cooldown 9
  target area
  radius 7
  damage 35 shock
  effect Speed -2 2
  about A ring of lightning bursts from you: everything close is hit and slowed.
end

ability meteor
  name Meteor
  cooldown 14
  cast 0.8
  still
  target area_at_aim
  range 50
  radius 6
  damage 90 fire
  speed 28
  arc 9.8
  about Stand still and call down a falling star where you aim.
end

ability venom_rain
  name Venom Rain
  cooldown 12
  channel 3 0.5
  target area_at_aim
  range 40
  radius 5
  damage 10 poison
  about Hold the key: poison rains where you aim, every half second.
end

ability battle_cry
  name Battle Cry
  cooldown 20
  target self
  self Damage 30 8
  about A roar that makes every shot and spell hit 30% harder for 8 seconds.
end

ability second_wind
  name Second Wind
  cooldown 25
  target self
  self Health 30
  self HealthRegen 12 5
  about Heals 30 at once, then 12 a second for 5 seconds.
end

ability surge
  name Surge
  cooldown 5
  target self
  move dash 12
  about Dash 12 metres the way you look.
end

ability leap
  name Leap
  cooldown 7
  target self
  move leap 11 10
  about Leap high and far: up 3 metres and 10 on.
end

ability blink
  name Blink
  cooldown 9
  target self
  move blink 14
  about Vanish and appear up to 14 metres ahead, short of walls.
end

ability haste
  name Haste
  cooldown 18
  target self
  self MoveSpeed 50 6
  about Run 50% faster for 6 seconds.
end

skill awaken
  name Awakening
  tree hero
  cost 1
  grant Health 10
  about Passive: +10 max health. Where every path starts.
  pos 5 0
end

skill frost
  name Frost Nova
  tree hero
  cost 1
  requires awaken
  unlocks frost_nova
  about Ability: A freezing burst around you: hits and slows everything close.
  pos 2 1
end

skill ice
  name Ice Lance
  tree hero
  cost 1
  requires frost
  unlocks ice_lance
  about Ability: A shard of ice that flies straight and slows what it hits.
  pos 1 2
end

skill focus
  name Focus
  tree hero
  cost 1
  requires frost
  grant CooldownReduction 10
  about Passive: abilities cool down 10% sooner.
  pos 3 2
end

skill storm
  name Lightning
  tree hero
  cost 2
  requires ice
  unlocks lightning
  about Ability: A bolt of lightning at what you aim at, far away.
  pos 0 3
end

skill shock
  name Shock Wave
  tree hero
  cost 2
  requires ice
